; tfc_rtv_mm.def - export GiveFnptrsToDll undecorated. metamod-p looks it up
; by its plain name with GetProcAddress before Meta_Query; MSVC would
; otherwise export the __stdcall-decorated "_GiveFnptrsToDll@8" and metamod
; would reject the DLL as "badf". Same as TFC Teams' and Weapon Changer Plus's.

LIBRARY "tfc_rtv_mm"

EXPORTS
	GiveFnptrsToDll
	GetEntityAPI2
	GetEngineFunctions
	Meta_Query
	Meta_Attach
	Meta_Detach
